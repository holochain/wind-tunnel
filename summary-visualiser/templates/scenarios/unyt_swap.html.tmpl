{{ define "unyt_swap_description" }}
<p>This scenario exercises HOT &rarr; wHOT bridging followed by wHOT &rarr; HF swaps.
The full-arc <code>initiate</code>, <code>bridge_agent</code>, and <code>swap_agent</code>
provide infrastructure. <code>user</code> and <code>zero_user</code> run the same
collection and swap workload with full and zero storage arcs respectively.
User outcomes remain separate below, including groups with no observed completions.</p>
{{ end }}

{{ define "unyt_swap_user_outcomes" }}
    {{ with .deposit_raves_collected }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Deposit RAVEs collected"
            "content" (tmpl.Exec "partitioned_counter_stats" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Deposit RAVEs collected"
            "content" "No counter data observed; this is not a measured zero."
        ) }}
    {{ end }}
    {{ with .swap_commitments_created }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap commitments created"
            "content" (tmpl.Exec "partitioned_counter_stats" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap commitments created"
            "content" "No counter data observed; this is not a measured zero."
        ) }}
    {{ end }}
    {{ with .swap_receipts_created }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap receipts created"
            "content" (tmpl.Exec "partitioned_counter_stats" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap receipts created"
            "content" "No counter data observed; this is not a measured zero."
        ) }}
    {{ end }}
{{ end }}

{{ define "unyt_swap_user_timings" }}
    {{ with .swap_completion_duration_s }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap completion time"
            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "Swap completion time"
            "content" "No successful samples observed."
        ) }}
    {{ end }}
    {{ with .get_incoming_raves_zome_call }}
        {{ template "scenario_metric_content_item" (dict
            "name" "get_incoming_raves"
            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "get_incoming_raves"
            "content" "No successful samples observed."
        ) }}
    {{ end }}
    {{ with .collect_from_rave_zome_call }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_collect_from_rave"
            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_collect_from_rave"
            "content" "No successful samples observed."
        ) }}
    {{ end }}
    {{ with .create_commitment_zome_call }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_commitment"
            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_commitment"
            "content" "No successful samples observed."
        ) }}
    {{ end }}
    {{ with .create_receipt_for_accept_zome_call }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_receipt_for_accept"
            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
        ) }}
    {{ else }}
        {{ template "scenario_metric_content_item" (dict
            "name" "create_receipt_for_accept"
            "content" "No successful samples observed."
        ) }}
    {{ end }}
{{ end }}

{{ define "unyt_swap_acceptance_directions" }}
    {{ range . }}
        {{ template "scenario_metric_content_item" (dict
            "name" (print .author_arc " author → " .acceptor_arc " acceptor")
            "content" (tmpl.Exec "scalar" (dict "value" .accepted_count))
        ) }}
    {{ else }}
        <p>No successful acceptance events observed.</p>
    {{ end }}
{{ end }}

{{ template "scenario_summary" (dict
    "title" "Unyt Swap"
    "description" (tmpl.Exec "unyt_swap_description")
    "data" .run_summary
) }}

<div class="scenario-metrics">
    {{ with .scenario_metrics }}
        {{ with .workloads_by_behaviour.user }}
            {{ template "scenario_metric" (dict
                "name" "user — outcomes"
                "description" (print .agent_count " registered users. Counter statistics use only observed agents, not all configured users. Receipts represent completed swaps.")
                "content" (tmpl.Exec "unyt_swap_user_outcomes" .)
            ) }}
            {{ template "scenario_metric" (dict
                "name" "user — timings"
                "description" "Successful zome calls only. Completion time runs from commitment creation to the matching receipt, including propagation and polling. Missing timing data does not mean zero latency."
                "content" (tmpl.Exec "unyt_swap_user_timings" .)
            ) }}
            {{ template "scenario_metric" (dict
                "name" "user — zome call errors"
                "description" "Failed zome calls observed for this user group."
                "content" (tmpl.Exec "scalar" (dict "value" .error_count))
            ) }}
        {{ end }}
        {{ with .workloads_by_behaviour.zero_user }}
            {{ template "scenario_metric" (dict
                "name" "zero_user — outcomes"
                "description" (print .agent_count " registered users. Counter statistics use only observed agents, not all configured users. Receipts represent completed swaps.")
                "content" (tmpl.Exec "unyt_swap_user_outcomes" .)
            ) }}
            {{ template "scenario_metric" (dict
                "name" "zero_user — timings"
                "description" "Successful zome calls only. Completion time runs from commitment creation to the matching receipt, including propagation and polling. Missing timing data does not mean zero latency."
                "content" (tmpl.Exec "unyt_swap_user_timings" .)
            ) }}
            {{ template "scenario_metric" (dict
                "name" "zero_user — zome call errors"
                "description" "Failed zome calls observed for this user group."
                "content" (tmpl.Exec "scalar" (dict "value" .error_count))
            ) }}
        {{ end }}

        {{ with .create_parked_link_zome_call }}
            {{ template "scenario_metric" (dict
                "name" "Bridge — create_parked_link"
                "description" "Successful infrastructure zome call duration, aggregated per agent."
                "content" (tmpl.Exec "timings_overall_and_per_agent" .)
            ) }}
        {{ end }}
        {{ with .create_parked_spend_zome_call }}
            {{ template "scenario_metric" (dict
                "name" "Bridge — create_parked_spend"
                "description" "Successful infrastructure zome call duration, aggregated per agent."
                "content" (tmpl.Exec "timings_overall_and_per_agent" .)
            ) }}
        {{ end }}
        {{ with .execute_rave_zome_call }}
            {{ template "scenario_metric" (dict
                "name" "Bridge — execute_rave"
                "description" "Successful infrastructure zome call duration, aggregated per agent."
                "content" (tmpl.Exec "timings_overall_and_per_agent" .)
            ) }}
        {{ end }}
        {{ with .create_accept_zome_call }}
            {{ template "scenario_metric" (dict
                "name" "Swap agent — create_accept"
                "description" "Successful infrastructure zome call duration, aggregated per agent."
                "content" (tmpl.Exec "timings_overall_and_per_agent" .)
            ) }}
        {{ end }}

        {{ with .bridge_parked_links_completed }}
            {{ template "scenario_metric" (dict
                "name" "Proof-of-deposit links completed"
                "description" "Cumulative infrastructure counters, aggregated across observed agents."
                "content" (tmpl.Exec "partitioned_counter_stats" .)
            ) }}
        {{ end }}
        {{ with .bridge_parked_links_failed }}
            {{ template "scenario_metric" (dict
                "name" "Proof-of-deposit links failed"
                "description" "Cumulative infrastructure counters, aggregated across observed agents."
                "content" (tmpl.Exec "partitioned_counter_stats" .)
            ) }}
        {{ end }}
        {{ with .commitments_accepted }}
            {{ template "scenario_metric" (dict
                "name" "Swap agent commitments accepted"
                "description" "Cumulative infrastructure counters, aggregated across observed agents."
                "content" (tmpl.Exec "partitioned_counter_stats" .)
            ) }}
        {{ end }}

        {{ template "scenario_metric" (dict
            "name" "Completed transaction RAVEs"
            "description" "Total RAVE agreement executions across all agents at teardown."
            "content" (tmpl.Exec "aggregated_single_value" .completed_transaction_raves)
        ) }}
        {{ template "scenario_metric" (dict
            "name" "Open connections by behaviour"
            "description" "Observed connection counts by assigned behaviour. Connections are not proof of synchronization readiness."
            "content" (tmpl.Exec "partitioned_gauge_stats" .open_connections)
        ) }}
        {{ template "scenario_metric" (dict
            "name" "Commitment acceptance directions"
            "description" "Unique successful commitment/acceptor pairs, correlated from the actual commitment author's arc to the acceptor's arc. Acceptance does not imply receipt completion."
            "content" (tmpl.Exec "unyt_swap_acceptance_directions" .accepted_commitments)
        ) }}
        {{ template "scenario_metric" (dict
            "name" "Run-wide zome call errors"
            "description" "Failed zome calls across users and infrastructure."
            "content" (tmpl.Exec "scalar" (dict "value" .error_count))
        ) }}
    {{ end }}

    {{ with .holochain_metrics }}{{ template "holochain_metrics" . }}{{ end }}
    {{ with .host_metrics }}{{ template "host_metrics" . }}{{ end }}
</div>
