{{ define "unyt_proposal_description" }}
<p>This scenario exercises negotiated Unyt transactions: proposals, counter-proposals,
commitments, acceptance or rejection, and receipts or reclaims. The full-arc
<code>initiate</code> agent initializes the network. Workload agents are reported
separately as full-arc <code>user</code> and zero-arc <code>zero_user</code>.
Both create proposals and respond to incoming transactions using the same workload.
Zero-arc agents rely on full-arc storage peers.</p>
{{ end }}

{{ template "scenario_summary" (dict
    "title" "Unyt Proposal"
    "description" (tmpl.Exec "unyt_proposal_description")
    "data" .run_summary
) }}

<div class="scenario-metrics">
    {{ with .scenario_metrics }}
        {{ template "scenario_metric" (dict
            "name" "Zome call errors — entire run"
            "description" "Includes infrastructure and all workload roles; failed calls are excluded from latency statistics."
            "content" (tmpl.Exec "scalar" (dict "value" .error_count))
        ) }}
        {{ template "scenario_metric" (dict
            "name" "Open connections by behaviour"
            "description" "Sampled connection counts, not proof of transaction delivery or storage-peer reachability."
            "content" (tmpl.Exec "partitioned_gauge_stats" .open_connections)
        ) }}
        <h2>Successful commitment acceptance directions</h2>
        <p>Actual commitment author arc → acceptor arc, counting unique commitment/acceptor pairs after successful acceptance. These are not terminal round-trip outcomes.</p>
        {{ range .accepted_commitments }}
            {{ template "scenario_metric" (dict
                "name" (printf "%s → %s" .author_arc .acceptor_arc)
                "description" "Successful commitment acceptances."
                "content" (tmpl.Exec "scalar" (dict "value" .accepted_count))
            ) }}
        {{ else }}
            <p>No successful commitment acceptance events observed.</p>
        {{ end }}

        {{ range $behaviour, $metrics := .workloads_by_behaviour }}
            <section class="unyt-proposal-workload">
                <h2>{{ $behaviour }}</h2>
                <p>Registered agents: {{ $metrics.agent_count }}.
                Agents with accepted round trips: {{ $metrics.proposal_round_trip_accepted_agent_count }};
                agents with rejected round trips: {{ $metrics.proposal_round_trip_rejected_agent_count }}.
                Missing observations are shown as no data, not as zero. Teardown counts describe the cutoff state, not eventual completion.</p>
                {{ template "scenario_metric" (dict
                    "name" "Zome call errors"
                    "description" "Errors for this workload role only."
                    "content" (tmpl.Exec "scalar" (dict "value" $metrics.error_count))
                ) }}
                {{ with $metrics.global_definition_propagation_time }}
                    {{ template "scenario_metric" (dict
                        "name" "Global definition propagation time"
                        "description" "Seconds since session start until initialization was first readable."
                        "content" (tmpl.Exec "timing_and_trend" .)
                    ) }}
                {{ else }}
                    <p>Global definition propagation time: no data.</p>
                {{ end }}
                {{ with $metrics.negotiation_rounds }}
                    {{ template "scenario_metric" (dict
                        "name" "Negotiation rounds"
                        "description" "Counter-proposal rounds before commitment; an observed zero means direct commitment."
                        "content" (tmpl.Exec "timing_and_trend" (merge . (dict "unit" "")))
                    ) }}
                {{ else }}
                    <p>Negotiation rounds: no data.</p>
                {{ end }}
                {{ range $field, $name := (dict
                    "proposal_round_trip_accepted" "Proposal round-trip time (accepted)"
                    "proposal_round_trip_rejected" "Proposal round-trip time (rejected)"
                    "sync_lag_proposal" "Sync lag — proposals"
                    "sync_lag_commitment" "Sync lag — commitments"
                    "sync_lag_accept" "Sync lag — accepts"
                    "sync_lag_reject" "Sync lag — rejects"
                    "create_proposal_zome_call" "Zome call — create_proposal"
                    "create_counter_proposal_zome_call" "Zome call — create_counter_proposal"
                    "create_commit_to_proposal_zome_call" "Zome call — create_commit_to_proposal"
                    "create_accept_zome_call" "Zome call — create_accept"
                    "create_reject_proposal_zome_call" "Zome call — create_reject_proposal"
                    "create_receipt_for_accept_zome_call" "Zome call — create_receipt_for_accept"
                    "create_reclaim_balance_zome_call" "Zome call — create_reclaim_balance"
                    "get_actionable_transactions_zome_call" "Zome call — get_actionable_transactions"
                ) }}
                    {{ with (index $metrics $field) }}
                        {{ template "scenario_metric" (dict
                            "name" $name
                            "description" "Seconds, aggregated within this role across observing agents. Zome timings include successful calls only; accepted round trips end at successful acceptance (not receipt), rejected round trips at rejection observation (not reclaim). Sync lag is publish-to-first-observation delay, clamped at zero for negative clock skew."
                            "content" (tmpl.Exec "timings_overall_and_per_agent" .)
                        ) }}
                    {{ else }}
                        <p>{{ $name }}: no data.</p>
                    {{ end }}
                {{ end }}
                {{ range $field, $name := (dict
                    "ui_action_list_refresh_duration_s" "UI action list refresh"
                    "ui_transaction_detail_item_refresh_duration_s" "UI single transaction detail refresh"
                    "ui_transaction_detail_refresh_duration_s" "UI all watched transaction details refresh"
                ) }}
                    {{ with (index $metrics $field) }}
                        {{ template "scenario_metric" (dict
                            "name" $name
                            "description" "Seconds spent simulating a UI refresh within this workload, including unsuccessful sub-calls."
                            "content" (tmpl.Exec "timing_and_trend" .)
                        ) }}
                    {{ else }}
                        <p>{{ $name }}: no data.</p>
                    {{ end }}
                {{ end }}
                {{ range $field, $name := (dict
                    "ui_action_list_refresh_failed_calls" "UI action list failed sub-calls"
                    "ui_transaction_detail_refresh_transactions_processed" "UI detail transaction items processed"
                    "ui_transaction_detail_refresh_primary_transaction_total_calls" "UI primary transaction fetch attempts"
                    "ui_transaction_detail_refresh_primary_transaction_failed_calls" "UI primary transaction fetch failures"
                    "ui_transaction_detail_refresh_related_transaction_total_calls" "UI related transaction fetch attempts"
                    "ui_transaction_detail_refresh_related_transaction_failed_calls" "UI related transaction fetch failures"
                ) }}
                    {{ with (index $metrics $field) }}
                        {{ template "scenario_metric" (dict
                            "name" $name
                            "description" "Cumulative per-agent counters, not sums of repeated running totals. Missing agents do not contribute; no data is not an observed zero."
                            "content" (tmpl.Exec "partitioned_counter_stats" .)
                        ) }}
                    {{ else }}
                        <p>{{ $name }}: no data.</p>
                    {{ end }}
                {{ end }}
                {{ range $field, $name := (dict
                    "completed_transaction_accepts" "Completed transaction accepts"
                    "completed_transaction_spends" "Completed transaction spends"
                    "completed_transaction_raves" "Completed transaction RAVEs"
                    "actionable_transaction_proposals" "Pending actionable proposals"
                    "actionable_transaction_commitments" "Pending actionable commitments"
                    "actionable_transaction_accepts" "Pending actionable accepts"
                    "actionable_transaction_rejects" "Pending actionable rejects"
                ) }}
                    {{ with (index $metrics $field) }}
                        {{ template "scenario_metric" (dict
                            "name" $name
                            "description" "Reported at teardown for this role. Partition count is the number of reporting agents. History can be partial and failed actionable reads can emit fallback zeros; these reports are not proof of successful reads or eventual settlement."
                            "content" (tmpl.Exec "aggregated_single_value" .)
                        ) }}
                    {{ else }}
                        <p>{{ $name }}: no teardown data.</p>
                    {{ end }}
                {{ end }}
            </section>
        {{ end }}
    {{ end }}
    {{ with .holochain_metrics }}{{ template "holochain_metrics" . }}{{ end }}
    {{ with .host_metrics }}{{ template "host_metrics" . }}{{ end }}
</div>
