{{- define "unyt_chain_transaction_zero_arc_description" }}
<p>Tests Unyt chain transaction system performance where some agents operate with a 0-arc DHT configuration. Measures data propagation between zero-arc and full-arc nodes. The scenario has five roles:</p>
<ul>
    <li><b><code>initiate</code></b>: Progenitor agent that initializes the network with system templates, global configuration, and foundational smart agreements</li>
    <li><b><code>zero_spend</code></b>: Zero-arc transaction agents that accept commitments and create spend transactions</li>
    <li><b><code>zero_smart_agreements</code></b>: Zero-arc agents that collect RAVEs and execute smart agreements</li>
    <li><b><code>full_observer</code></b>: Full-arc observer agents that passively monitor data propagation</li>
    <li><b><code>zero_observer</code></b>: Zero-arc observer agents that passively monitor data propagation for comparison</li>
</ul>
{{ end -}}

{{ template "scenario_summary" (dict
    "title" "Unyt Chain Transaction Zero Arc"
    "description" (tmpl.Exec "unyt_chain_transaction_zero_arc_description")
    "data" .run_summary
) }}

<div class="scenario-metrics">
    {{ with .scenario_metrics }}
        {{ $metrics := . }}

        {{ template "scenario_metric" (dict
            "name" "Global definition propagation time"
            "description" "Time from session start until each agent detected the global_definition propagation. Shows aggregate statistics across arc types and agents."
            "content" (tmpl.Exec "timings_overall_and_per_agent" .global_definition_propagation_time)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Sync lag: Commitment transactions"
            "description" "Time between commitment creation and discovery by the receiving agent (seconds). Shows aggregate statistics across arc types and agents."
            "content" (tmpl.Exec "timings_overall_and_per_agent" .sync_lag_commitment)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Sync lag: RAVE transactions"
            "description" "Time between RAVE creation and discovery by smart_agreements agents (seconds). Shows aggregate statistics across arc types and agents."
            "content" (tmpl.Exec "timings_overall_and_per_agent" .sync_lag_rave)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Sync lag: Grouped parked requests"
            "description" "Time between grouped_parked request creation and discovery (seconds). Shows aggregate statistics across arc types and agents."
            "content" (tmpl.Exec "timings_overall_and_per_agent" .sync_lag_grouped_parked)
        ) }}

        {{ with .ledger_balance.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Final ledger balance"
                "description" "Final ledger balance across all agents at teardown (base unyt units), partitioned by agent."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.ledger_balance)
            ) }}
        {{ end }}

        {{ with .ledger_fees.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Final ledger fees"
                "description" "Final ledger fees owed across all agents at teardown (base unyt units)."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.ledger_fees)
            ) }}
        {{ end }}

        {{ with .actionable_transaction_proposals.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Actionable transaction proposals"
                "description" "Remaining actionable transaction proposals at teardown. Non-zero sum indicates work left unfinished."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.actionable_transaction_proposals)
            ) }}
        {{ end }}

        {{ with .actionable_transaction_commitments.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Actionable transaction commitments"
                "description" "Remaining actionable transaction commitments at teardown. Non-zero sum indicates work left unfinished."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.actionable_transaction_commitments)
            ) }}
        {{ end }}

        {{ with .actionable_transaction_accepts.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Actionable transaction accepts"
                "description" "Remaining actionable transaction accepts at teardown. Non-zero sum indicates work left unfinished."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.actionable_transaction_accepts)
            ) }}
        {{ end }}

        {{ with .actionable_transaction_rejects.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Actionable transaction rejects"
                "description" "Remaining actionable transaction rejects at teardown. Non-zero sum indicates work left unfinished."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.actionable_transaction_rejects)
            ) }}
        {{ end }}

        {{ with .completed_transaction_accepts.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Completed transaction accepts"
                "description" "Completed transaction accepts at teardown."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.completed_transaction_accepts)
            ) }}
        {{ end }}

        {{ with .completed_transaction_spends.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Completed transaction spends"
                "description" "Completed transaction spends at teardown."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.completed_transaction_spends)
            ) }}
        {{ end }}

        {{ with .completed_transaction_raves.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Completed transaction RAVEs"
                "description" "Completed transaction RAVEs at teardown."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.completed_transaction_raves)
            ) }}
        {{ end }}

        {{ with .parked_spends.partition_count }}
            {{ template "scenario_metric" (dict
                "name" "Parked spends"
                "description" "Parked spend counts at teardown. These are pending link-spending transactions."
                "content" (tmpl.Exec "aggregated_single_value" $metrics.parked_spends)
            ) }}
        {{ end }}

        {{ with .recv_count }}
            {{ template "scenario_metric" (dict
                "name" "Code template discovery count"
                "description" "Cumulative count of unique code templates discovered by observer agents over the run. Shows aggregate statistics across arc types and agents."
                "content" (tmpl.Exec "partitioned_counter_stats" .)
            ) }}
        {{ end }}

        {{ template "scenario_metric" (dict
            "name" "Check agent exists: Duration"
            "description" "Duration of the check_agent_exists loop per behaviour iteration (seconds)."
            "content" (tmpl.Exec "timing_and_trend" .check_agent_exists_duration_s)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Check agent exists: Total calls"
            "description" "Total check_agent_exists calls made across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .check_agent_exists_total_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Check agent exists: Failed calls"
            "description" "Total check_agent_exists calls that failed across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .check_agent_exists_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Check agent exists: Missing agents"
            "description" "Total check_agent_exists calls that reported a missing agent across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .check_agent_exists_missing_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI action list refresh: Duration"
            "description" "Duration of the UI action list refresh per behaviour iteration (seconds)."
            "content" (tmpl.Exec "timing_and_trend" .ui_action_list_refresh_duration_s)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI action list refresh: Failed calls"
            "description" "Total UI action list refresh calls that failed across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_action_list_refresh_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI routine refresh: Duration"
            "description" "Duration of the full UI routine refresh per behaviour iteration (seconds), including check_agent_exists, action list refresh, and transaction detail refresh."
            "content" (tmpl.Exec "timing_and_trend" .ui_routine_refresh_duration_s)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI routine refresh: Watchlist count"
            "description" "Watchlist size (number of transactions being tracked) per behaviour iteration. Indicates how many transactions agents are actively monitoring."
            "content" (tmpl.Exec "aggregated_single_value" .ui_routine_refresh_watchlist_count)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail item refresh: Duration"
            "description" "Duration of refreshing a single transaction detail item per behaviour iteration (seconds)."
            "content" (tmpl.Exec "timing_and_trend" .ui_transaction_detail_item_refresh_duration_s)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail item refresh: Primary transaction total calls"
            "description" "Total primary transaction fetches made during per-item detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_item_refresh_primary_transaction_total_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail item refresh: Primary transaction failed calls"
            "description" "Total primary transaction fetches that failed during per-item detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_item_refresh_primary_transaction_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail item refresh: Related transaction total calls"
            "description" "Total related transaction fetches made during per-item detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_item_refresh_related_transaction_total_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail item refresh: Related transaction failed calls"
            "description" "Total related transaction fetches that failed during per-item detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_item_refresh_related_transaction_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Duration"
            "description" "Duration of refreshing all watched transaction details per behaviour iteration (seconds)."
            "content" (tmpl.Exec "timing_and_trend" .ui_transaction_detail_refresh_duration_s)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Transactions processed"
            "description" "Total number of transactions processed during the detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_refresh_transactions_processed)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Primary transaction total calls"
            "description" "Total primary transaction fetches made during the full detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_refresh_primary_transaction_total_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Primary transaction failed calls"
            "description" "Total primary transaction fetches that failed during the full detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_refresh_primary_transaction_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Related transaction total calls"
            "description" "Total related transaction fetches made during the full detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_refresh_related_transaction_total_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "UI transaction detail refresh: Related transaction failed calls"
            "description" "Total related transaction fetches that failed during the full detail refresh across all agents and iterations."
            "content" (tmpl.Exec "aggregated_single_value" .ui_transaction_detail_refresh_related_transaction_failed_calls)
        ) }}

        {{ template "scenario_metric" (dict
            "name" "Error count"
            "description" "The total number of errors accumulated across all agents over the run."
            "content" (tmpl.Exec "scalar" (dict "value" .error_count))
        ) }}

    {{ end }}

    {{ with .holochain_metrics }}{{ template "holochain_metrics" . }}{{ end }}

    {{ with .host_metrics }}
        {{ template "host_metrics" . }}
    {{ end }}
</div>
