{{/*
  Format a byte value to human-readable (B, KiB, MiB, GiB).
  Fields:
  * `value` (number): The byte value to format.
  * `label` (string, optional): A label to display before the value.
  * `suffix` (string, optional): A suffix to append to the unit (e.g. "/s").
  */}}

{{- $value := conv.ToFloat64 .value -}}
{{- $suffix := default "" (index . "suffix") -}}
{{- $label := default "" (index . "label") -}}
{{- if (ge $value 1073741824.0) -}}
    {{ template "scalar" (dict "label" $label "value" (printf "%.2f" (math.Div $value 1073741824.0)) "unit" (printf "GiB%s" $suffix)) }}
{{- else if (ge $value 1048576.0) -}}
    {{ template "scalar" (dict "label" $label "value" (printf "%.2f" (math.Div $value 1048576.0)) "unit" (printf "MiB%s" $suffix)) }}
{{- else if (ge $value 1024.0) -}}
    {{ template "scalar" (dict "label" $label "value" (printf "%.2f" (math.Div $value 1024.0)) "unit" (printf "KiB%s" $suffix)) }}
{{- else -}}
    {{ template "scalar" (dict "label" $label "value" (printf "%.0f" $value) "unit" (printf "B%s" $suffix)) }}
{{- end -}}