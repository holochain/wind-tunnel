            "content" (tmpl.Exec "timing_and_trend" .)
        ) }}
    {{ end }}
{{ end }}

{{/* === P2P === */}}
{{ with (index . "p2p") }}
    {{ with (index . "request_duration") }}
        {{ if (index . "get") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'get'"
                "description" "Time spent sending a get request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .get)
            ) }}
        {{ end }}

        {{ if (index . "get_links") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'get_links'"
                "description" "Time spent sending a get_links request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .get_links)
            ) }}
        {{ end }}

        {{ if (index . "count_links") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'count_links'"
                "description" "Time spent sending a count_links request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .count_links)
            ) }}
        {{ end }}

        {{ if (index . "get_agent_activity") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'get_agent_activity'"
                "description" "Time spent sending a get_agent_activity request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .get_agent_activity)
            ) }}
        {{ end }}

        {{ if (index . "must_get_agent_activity") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'must_get_agent_activity'"
                "description" "Time spent sending a must_get_agent_activity request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .must_get_agent_activity)
            ) }}
        {{ end }}

        {{ if (index . "send_validation_receipts") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'send_validation_receipts'"
                "description" "Time spent sending a send_validation_receipts request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .send_validation_receipts)
            ) }}
        {{ end }}

        {{ if (index . "call_remote") }}
            {{ template "scenario_metric" (dict
                "name" "P2P request roundtrip: 'call_remote'"
                "description" "Time spent sending a call_remote request and awaiting its response."
                "content" (tmpl.Exec "timing_and_trend" .call_remote)
            ) }}
        {{ end }}
    {{ end }}

    {{ with (index . "handle_request_duration") }}
        {{ if (index . "response") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'response'"
                "description" "Time spent handling an incoming response message."
                "content" (tmpl.Exec "timing_and_trend" .response)
            ) }}
        {{ end }}

        {{ if (index . "call_remote") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'call_remote'"
                "description" "Time spent handling an incoming call_remote request."
                "content" (tmpl.Exec "timing_and_trend" .call_remote)
            ) }}
        {{ end }}

        {{ if (index . "get") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'get'"
                "description" "Time spent handling an incoming get request."
                "content" (tmpl.Exec "timing_and_trend" .get)
            ) }}
        {{ end }}

        {{ if (index . "get_links") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'get_links'"
                "description" "Time spent handling an incoming get_links request."
                "content" (tmpl.Exec "timing_and_trend" .get_links)
            ) }}
        {{ end }}

        {{ if (index . "count_links") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'count_links'"
                "description" "Time spent handling an incoming count_links request."
                "content" (tmpl.Exec "timing_and_trend" .count_links)
            ) }}
        {{ end }}

        {{ if (index . "get_agent_activity") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'get_agent_activity'"
                "description" "Time spent handling an incoming get_agent_activity request."
                "content" (tmpl.Exec "timing_and_trend" .get_agent_activity)
            ) }}
        {{ end }}

        {{ if (index . "must_get_agent_activity") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'must_get_agent_activity'"
                "description" "Time spent handling an incoming must_get_agent_activity request."
                "content" (tmpl.Exec "timing_and_trend" .must_get_agent_activity)
            ) }}
        {{ end }}

        {{ if (index . "send_validation_receipts") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'send_validation_receipts'"
                "description" "Time spent handling an incoming send_validation_receipts request."
                "content" (tmpl.Exec "timing_and_trend" .send_validation_receipts)
            ) }}
        {{ end }}

        {{ if (index . "remote_signal") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'remote_signal'"
                "description" "Time spent handling an incoming remote_signal request."
                "content" (tmpl.Exec "timing_and_trend" .remote_signal)
            ) }}
        {{ end }}

        {{ if (index . "publish_counter_sign") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'publish_counter_sign'"
                "description" "Time spent handling an incoming publish_counter_sign request."
                "content" (tmpl.Exec "timing_and_trend" .publish_counter_sign)
            ) }}
        {{ end }}

        {{ if (index . "countersigning_session_negotiation") }}
            {{ template "scenario_metric" (dict
                "name" "P2P handle incoming: 'countersigning_session_negotiation'"
                "description" "Time spent handling an incoming countersigning_session_negotiation request."
                "content" (tmpl.Exec "timing_and_trend" .countersigning_session_negotiation)
            ) }}
        {{ end }}
    {{ end }}

    {{ with (index . "ignored_request_count") }}
        {{ template "scenario_metric" (dict
            "name" "P2P ignored requests"
            "description" "Count of incoming P2P requests that were ignored."
            "content" (tmpl.Exec "delta" .)
        ) }}
    {{ end }}

    {{ with (index . "recv_remote_signal_count") }}
        {{ template "scenario_metric" (dict
            "name" "P2P received remote signals"
            "description" "Count of remote signals received."
            "content" (tmpl.Exec "delta" .)
        ) }}
    {{ end }}
{{ end }}
