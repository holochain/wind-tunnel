{{ with (index . "db_write_txn_duration") }}
    {{ template "scenario_metric" (dict
        "name" "Write transaction duration"
        "description" "Duration of exclusive write transactions across all databases."
        "content" (tmpl.Exec "timing_and_trend" .)
    ) }}
{{ end }}

{{/* === Keystore === */}}
{{ with (index . "lair_request_duration") }}
    {{ with (index . "sign") }}
        {{ template "scenario_metric" (dict
            "name" "Lair keystore: signing"
            "description" "Duration of Ed25519 signing requests to the Lair keystore."
            "content" (tmpl.Exec "timing_and_trend" .)
        ) }}
    {{ end }}
    {{ with (index . "shared_secret_encrypt") }}
        {{ template "scenario_metric" (dict
            "name" "Lair keystore: shared secret encryption"
            "description" "Duration of shared-secret encryption requests to the Lair keystore."
            "content" (tmpl.Exec "timing_and_trend" .)
        ) }}
    {{ end }}
    {{ with (index . "crypto_box_xsalsa") }}
        {{ template "scenario_metric" (dict
            "name" "Lair keystore: crypto_box"
