{{/*
Render all Holochain internal metrics.
Receives the top-level HolochainMetrics struct.
Each section uses (index . "key") for nil-safety with skip_serializing_none.
*/}}

{{/* === Cascade === */}}
{{ with (index . "cascade_duration") }}
    {{ template "scenario_metric" (dict
        "name" "Cascade duration"
        "description" "Time taken to execute a cascade (get) query inside Holochain."
        "content" (tmpl.Exec "timing_and_trend" .)
    ) }}
{{ end }}

{{ with (index . "cascade_fetch_error_count") }}
    {{ template "scenario_metric" (dict
        "name" "Cascade fetch errors"
        "description" "Count of network fetch errors during cascade operations."
        "content" (tmpl.Exec "delta" .)
    ) }}
{{ end }}

{{/* === Ribosome === */}}
{{ with (index . "wasm_usage") }}
    {{ range $key, $value := . }}
        {{ template "scenario_metric" (dict
            "name" (print "WASM usage: '" $key "'")
            "description" "Metered usage count of the WASM ribosome for this zome function."
            "content" (tmpl.Exec "delta" $value)
        ) }}
    {{ end }}
{{ end }}

{{ with (index . "zome_call_duration") }}
    {{ range $key, $value := . }}
        {{ template "scenario_metric" (dict
            "name" (print "Zome call duration: '" $key "'")
            "description" "Duration of this zome call as measured by Holochain internally."
            "content" (tmpl.Exec "timing_and_trend" $value)
        ) }}
    {{ end }}
{{ end }}

{{ with (index . "wasm_call_duration") }}
    {{ range $key, $value := . }}
        {{ template "scenario_metric" (dict
            "name" (print "WASM call duration: '" $key "'")
            "description" "Duration of inner WASM calls for this function, excluding Holochain overhead."
            "content" (tmpl.Exec "timing_and_trend" $value)
        ) }}
    {{ end }}
{{ end }}

{{ with (index . "host_fn_call_duration") }}
    {{ range $key, $value := . }}
        {{ template "scenario_metric" (dict
            "name" (print "Host function call duration: '" $key "'")
            "description" "Duration of this host function call invoked from within WASM."
            "content" (tmpl.Exec "timing_and_trend" $value)
        ) }}
    {{ end }}
{{ end }}

{{ with (index . "emit_signal_count") }}
    {{ template "scenario_metric" (dict
        "name" "Emitted local signals"
        "description" "Count of local signals emitted via the emit_signal host function."
        "content" (tmpl.Exec "delta" .)
    ) }}
{{ end }}

{{ with (index . "send_remote_signal_count") }}
    {{ template "scenario_metric" (dict
        "name" "Sent remote signals"
        "description" "Count of remote signals sent via the send_remote_signal host function."
        "content" (tmpl.Exec "delta" .)
    ) }}
{{ end }}

{{/* === Conductor === */}}
{{ with (index . "post_commit_duration") }}
    {{ template "scenario_metric" (dict
        "name" "Post-commit duration"
        "description" "Time spent executing post-commit workflows."
        "content" (tmpl.Exec "timing_and_trend" .)
    ) }}
{{ end }}

{{ with (index . "uptime") }}
    {{ template "scenario_metric" (dict
        "name" "Conductor uptime"
        "description" "Conductor uptime gauge. A drop in the trend indicates a restart during the run."
        "content" (tmpl.Exec "min_max_mean_std" (merge (dict "unit" "s") .))
    ) }}
{{ end }}

{{ with (index . "dropped_signal_count") }}
    {{ template "scenario_metric" (dict
        "name" "Dropped WebSocket signals"
        "description" "Count of signals dropped from the app WebSocket due to channel overload."
        "content" (tmpl.Exec "delta" .)
    ) }}
{{ end }}

{{ with (index . "integrated_ops_count") }}
    {{ template "scenario_metric" (dict
        "name" "Integrated ops"
        "description" "Count of DHT operations integrated since the conductor started. Resets on restart."
        "content" (tmpl.Exec "delta" .)
    ) }}
{{ end }}

{{ with (index . "integration_delay") }}
    {{ template "scenario_metric" (dict
        "name" "Integration delay"
        "description" "Delay between an op being stored and being integrated. High values indicate the pipeline is falling behind."
        "content" (tmpl.Exec "timing_and_trend" .)
    ) }}
{{ end }}

{{ with (index . "validation_attempts") }}
    {{ template "scenario_metric" (dict
        "name" "Validation attempts per op"
        "description" "Number of validation attempts required per operation. Values consistently above 1 indicate retries."
        "content" (tmpl.Exec "timing_and_trend" .)
    ) }}
{{ end }}

