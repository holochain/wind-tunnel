{
  "job_name": "unyt_proposal_demo",
  "scenario_name": "unyt_proposal",
  "duration": 300,
  "assignments": [
    {
      "behaviour": "initiate"
    },
    {
      "behaviour": "propose",
      "nodes": 2
    },
    {
      "behaviour": "respond",
      "nodes": 2
    }
  ],
  "env": {
    "MIN_AGENTS": "5",
    "UNYT_NUMBER_OF_LINKS_TO_PROCESS": "10",
    "UNYT_PROPOSER_WEIGHTS": "60,20,20",
    "UNYT_RESPONDER_WEIGHTS": "60,20,20",
    "UNYT_COMMITMENT_ACCEPT_PCT": "80",
    "UNYT_COUNTER_ADJUSTMENT_PCT": "10",
    "UNYT_MAX_NEGOTIATION_ROUNDS": "5"
  }
}
