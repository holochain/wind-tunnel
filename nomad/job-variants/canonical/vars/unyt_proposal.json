{
  "description": "1 full-arc progenitor initialises the network; 15 full-arc and 14 zero-arc users each propose to peers and respond to incoming transactions (30 nodes total).",
  "job_name": "unyt_proposal_canonical",
  "scenario_name": "unyt_proposal",
  "duration": 900,
  "assignments": [
    {
      "behaviour": "initiate"
    },
    {
      "behaviour": "user",
      "nodes": 15
    },
    {
      "behaviour": "zero_user",
      "nodes": 14
    }
  ],
  "env": {
    "MIN_AGENTS": "30",
    "UNYT_PROPOSAL_WEIGHTS": "60,20,20",
    "UNYT_COMMITMENT_ACCEPT_PCT": "80",
    "UNYT_COUNTER_ADJUSTMENT_PCT": "10",
    "UNYT_MAX_NEGOTIATION_ROUNDS": "5",
    "UNYT_SPEND_FRACTION_PCT": "10"
  }
}
