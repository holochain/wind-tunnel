{
  "description": "1 full-arc progenitor initialises the network; 15 proposers (8 full arc, 7 zero arc) and 14 responders (7 full arc, 7 zero arc) run concurrent proposal flows. Target 50/50 proposer/responder; actual 51.7/48.3 at 29 workload agents (30 nodes total).",
  "job_name": "unyt_proposal_canonical",
  "scenario_name": "unyt_proposal",
  "duration": 900,
  "assignments": [
    {
      "behaviour": "initiate"
    },
    {
      "behaviour": "full_propose",
      "nodes": 8
    },
    {
      "behaviour": "zero_propose",
      "nodes": 7
    },
    {
      "behaviour": "full_respond",
      "nodes": 7
    },
    {
      "behaviour": "zero_respond",
      "nodes": 7
    }
  ],
  "env": {
    "MIN_AGENTS": "30",
    "UNYT_NUMBER_OF_LINKS_TO_PROCESS": "10",
    "UNYT_PROPOSER_WEIGHTS": "60,20,20",
    "UNYT_RESPONDER_WEIGHTS": "60,20,20",
    "UNYT_COMMITMENT_ACCEPT_PCT": "80",
    "UNYT_COUNTER_ADJUSTMENT_PCT": "10",
    "UNYT_MAX_NEGOTIATION_ROUNDS": "5"
  }
}
