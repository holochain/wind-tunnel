{
  "description": "1 progenitor initialises the network; 29 user agents run concurrent proposal flows. Each user both proposes to peers and responds to incoming proposals/commitments (30 nodes total).",
  "job_name": "unyt_proposal_canonical",
  "scenario_name": "unyt_proposal",
  "duration": 900,
  "assignments": [
    {
      "behaviour": "initiate"
    },
    {
      "behaviour": "user",
      "nodes": 29
    }
  ],
  "env": {
    "MIN_AGENTS": "30",
    "UNYT_PROPOSAL_WEIGHTS": "60,20,20",
    "UNYT_COMMITMENT_ACCEPT_PCT": "80",
    "UNYT_COUNTER_ADJUSTMENT_PCT": "10",
    "UNYT_MAX_NEGOTIATION_ROUNDS": "5",
    "UNYT_SPEND_FRACTION_PCT": "10"
  }
}
